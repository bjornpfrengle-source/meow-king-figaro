    "express": "^4.22.1",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.11.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.2",
    "sharp": "^0.35.3",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.14.0",
    "@types/express": "^4.17.25",
